@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix qb:     <http://qb.intuit.com/ontology/> .
@prefix unspsc: <http://qb.intuit.com/unspsc/> .

# ============================================================
# UNSPSC HIERARCHY — Demo Subset
#
# Structure: Segment (2-digit) → Family (4-digit) →
#            Class (6-digit) → Commodity (8-digit)
#
# Covers commodities that cross-link to NAICS sectors in the
# demo: plumbing services/supplies, electrical, construction
# materials, food service supplies.
# ============================================================

# --- Segment 72: Building and Facility Construction and Maintenance Services ---

unspsc:72 a qb:UNSPSCCode ;
    rdfs:label "Building and Facility Construction and Maintenance Services" .

unspsc:7215 a qb:UNSPSCCode ;
    rdfs:label "Plumbing and Heating Services" ;
    rdfs:subClassOf unspsc:72 .

unspsc:72151500 a qb:UNSPSCCode ;
    rdfs:label "Plumbing Services" ;
    rdfs:subClassOf unspsc:7215 .

unspsc:72151501 a qb:UNSPSCCode ;
    rdfs:label "Plumbing Installation" ;
    rdfs:subClassOf unspsc:72151500 .

unspsc:72151502 a qb:UNSPSCCode ;
    rdfs:label "Plumbing Repair and Maintenance" ;
    rdfs:subClassOf unspsc:72151500 .

unspsc:72151600 a qb:UNSPSCCode ;
    rdfs:label "Heating System Services" ;
    rdfs:subClassOf unspsc:7215 .

unspsc:7214 a qb:UNSPSCCode ;
    rdfs:label "Electrical Services" ;
    rdfs:subClassOf unspsc:72 .

unspsc:72141000 a qb:UNSPSCCode ;
    rdfs:label "Electrical Installation" ;
    rdfs:subClassOf unspsc:7214 .

unspsc:72141100 a qb:UNSPSCCode ;
    rdfs:label "Electrical Repair and Maintenance" ;
    rdfs:subClassOf unspsc:7214 .

unspsc:7211 a qb:UNSPSCCode ;
    rdfs:label "Building Construction Services" ;
    rdfs:subClassOf unspsc:72 .

unspsc:72111000 a qb:UNSPSCCode ;
    rdfs:label "Residential Building Construction Services" ;
    rdfs:subClassOf unspsc:7211 .

unspsc:72112000 a qb:UNSPSCCode ;
    rdfs:label "Commercial Building Construction Services" ;
    rdfs:subClassOf unspsc:7211 .

unspsc:7212 a qb:UNSPSCCode ;
    rdfs:label "Building Maintenance Services" ;
    rdfs:subClassOf unspsc:72 .

unspsc:72121000 a qb:UNSPSCCode ;
    rdfs:label "Painting and Coating Services" ;
    rdfs:subClassOf unspsc:7212 .

