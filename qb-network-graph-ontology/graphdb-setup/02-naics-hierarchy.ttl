@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix qb:     <http://qb.intuit.com/ontology/> .
@prefix naics:  <http://qb.intuit.com/naics/> .

# ============================================================
# NAICS HIERARCHY — Demo Subset
#
# Structure: Sector (2-digit) → Subsector (3-digit) →
#            Industry Group (4-digit) → Industry (6-digit)
#
# Covers the key demo scenario: plumbing wholesaler (42)
# vs plumbing contractor (23) linked via shared commodities.
# ============================================================

# --- Sector 23: Construction ---

naics:23 a qb:NAICSCode ;
    rdfs:label "Construction" .

naics:236 a qb:NAICSCode ;
    rdfs:label "Construction of Buildings" ;
    rdfs:subClassOf naics:23 .

naics:2361 a qb:NAICSCode ;
    rdfs:label "Residential Building Construction" ;
    rdfs:subClassOf naics:236 .

naics:236110 a qb:NAICSCode ;
    rdfs:label "Residential Building Construction" ;
    rdfs:subClassOf naics:2361 .

naics:236220 a qb:NAICSCode ;
    rdfs:label "Commercial Building Construction" ;
    rdfs:subClassOf naics:2361 .

naics:238 a qb:NAICSCode ;
    rdfs:label "Specialty Trade Contractors" ;
    rdfs:subClassOf naics:23 .

naics:2382 a qb:NAICSCode ;
    rdfs:label "Building Equipment Contractors" ;
    rdfs:subClassOf naics:238 .

naics:238220 a qb:NAICSCode ;
    rdfs:label "Plumbing, Heating, and Air-Conditioning Contractors" ;
    rdfs:subClassOf naics:2382 .

naics:238210 a qb:NAICSCode ;
    rdfs:label "Electrical Contractors" ;
    rdfs:subClassOf naics:2382 .

naics:2381 a qb:NAICSCode ;
    rdfs:label "Foundation, Structure, and Building Exterior Contractors" ;
    rdfs:subClassOf naics:238 .

naics:238110 a qb:NAICSCode ;
    rdfs:label "Poured Concrete Foundation and Structure Contractors" ;
    rdfs:subClassOf naics:2381 .

naics:238120 a qb:NAICSCode ;
    rdfs:label "Structural Steel and Precast Concrete Contractors" ;
    rdfs:subClassOf naics:2381 .

naics:2383 a qb:NAICSCode ;
    rdfs:label "Building Finishing Contractors" ;
    rdfs:subClassOf naics:238 .

naics:238320 a qb:NAICSCode ;
    rdfs:label "Painting and Wall Covering Contractors" ;
    rdfs:subClassOf naics:2383 .

naics:238330 a qb:NAICSCode ;
    rdfs:label "Flooring Contractors" ;
